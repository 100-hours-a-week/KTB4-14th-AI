# 최소 32자 이상으로 설정해야 하며, 해당 값은 AI 서버를 호출하는 백엔드에서만 공유해서 사용합니다.
AUDIGO_API_TOKEN=
AUDIGO_MODE=live
OPEN_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kakao 장소 검색은 서버에서 처리하며 KAKAO_REST_API_KEY만 사용합니다.
KAKAO_REST_API_KEY=
# 네이버 지도에서 직접 확인해 작성한 식당 영업시간 JSON의 절대 경로.
# 제주 기본 데이터 외의 지역/식당 데이터를 설정하면 기록이 없는 식당은 후보에서 제외합니다.
# RESTAURANT_HOURS_FILE=/absolute/path/to/restaurant_hours.json
KAKAO_JAVASCRIPT_KEY=
KAKAO_MAP_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_ANDROID_NATIVE_APP_KEY=

# Job APIs: Redis + Celery. Use separate Redis DBs for status and broker.
REDIS_URL=redis://127.0.0.1:6379/0
JOBS_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
JOB_TTL_SECONDS=86400
JOB_MAX_RETRIES=2
JOB_RETRY_DELAY_SECONDS=5

# MySQL 매칭 조회: 제공된 backend development의 matching_* 테이블 매핑.
MATCHING_MYSQL_HOST=127.0.0.1
MATCHING_MYSQL_PORT=3306
MATCHING_MYSQL_DATABASE=
MATCHING_MYSQL_USER=
MATCHING_MYSQL_PASSWORD=
# 로컬 소켓 접속 시에만 설정 (Docker에서는 호스트 소켓을 사용하지 않음)
MATCHING_MYSQL_SOCKET=
MATCHING_MYSQL_SSL_CA=
MATCHING_MYSQL_QUERY_FILE=

# 합 1. 기본은 기존 코사인 점수. 개발 평가 --apply는 선택한 가중치를 저장합니다.
MATCHING_E5_WEIGHT=1.0
MATCHING_THEME_WEIGHT=0.0
MATCHING_PACE_WEIGHT=0.0
AUDIGO_AI_MATCHING_CANDIDATE_LIMIT=3
