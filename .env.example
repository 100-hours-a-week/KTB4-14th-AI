# 최소 32자 이상으로 설정해야 하며, 해당 값은 AI 서버를 호출하는 백엔드에서만 공유해서 사용합니다.
AUDIGO_API_TOKEN=
AUDIGO_MODE=live
OPEN_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kakao 장소 검색은 서버에서 처리하며 KAKAO_REST_API_KEY만 사용합니다.
KAKAO_REST_API_KEY=
# 네이버 지도에서 직접 확인해 작성한 식당 영업시간 JSON의 절대 경로.
# 제주 기본 데이터 외의 지역/식당 데이터를 설정하면 기록이 없는 식당은 후보에서 제외합니다.
# RESTAURANT_HOURS_FILE=/absolute/path/to/restaurant_hours.json
KAKAO_JAVASCRIPT_KEY=
KAKAO_MAP_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_ANDROID_NATIVE_APP_KEY=
